# MongoDB
MONGO_URI=mongodb://localhost:27017/cinfy_lead_tracker

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key
REFRESH_TOKEN_EXPIRE=30d

# Server
PORT=5000
NODE_ENV=development

# Session
SESSION_SECRET=your_session_secret_key_change_this

# Multer
MAX_FILE_SIZE=5242880
MAX_FILE_SIZE_MB=5

# CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001

# Email (Optional - for future use)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_password

# API Keys
API_KEY_PREFIX=sk_live_

# Twilio Voice Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_account_sid
TWILIO_PHONE_NUMBER=your_twilio_account_sid

# OpenAI Configuration (GPT-3.5 Turbo for speech conversation & call analysis)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Public Base URL (Required for Twilio Webhooks: e.g. Cloudflare Tunnel / Ngrok / Domain)
PUBLIC_BASE_URL=https://your-crm-domain.com
APP_URL=https://your-crm-domain.com
